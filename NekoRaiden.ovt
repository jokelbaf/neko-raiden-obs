@OBSThemeMeta {
    name: 'Neko Raiden';
    id: 'com.jokelbaf.Yami.NekoRaiden';
    extends: 'com.obsproject.Yami';
    author: 'jokelbaf';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #6F6095;
    --grey2: #5A4B7F;
    --grey3: #463A68;
    --grey4: #372C55;
    --grey5: #2A2143;
    --grey6: #201935;
    --grey7: #171228;
    --grey8: #0E0A19;

    --purple1: #C9AEFF;
    --purple2: #A57CFF;
    --purple3: #8A5CF0;
    --purple4: #6E44CF;
    --purple5: #52309E;
    --purple6: #351E6B;

    --yellow1: #F3DCA4;
    --yellow2: #E4C27A;
    --yellow3: #C9A257;
    --yellow4: #A07D3D;
    --yellow5: #6E5428;
    --yellow6: #3D2E16;

    --red1: #F17D93;
    --red2: #E8506C;
    --red3: #C9304E;
    --red4: #A3243E;
    --red5: #6F1A2E;
    --red6: #43101C;

    --white1: #F4F0FF;
    --white2: #E3DCF7;
    --white3: #CFC5EC;
    --white4: #B3A6D6;
    --white5: #9487B8;

    --blue1: #C9AEFF;
    --blue2: #A57CFF;
    --blue3: #8A5CF0;
    --blue4: #6E44CF;
    --blue5: #52309E;
    --blue6: #351E6B;

    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--purple4);
    --primary_light: var(--purple3);
    --primary_lighter: var(--purple1);
    --primary_dark: var(--purple5);
    --primary_darker: var(--purple6);

    --warning: var(--yellow3);
    --danger: var(--red3);

    --text: var(--white1);
    --text_light: var(--white1);
    --text_muted: var(--white5);
    --text_disabled: #6C6290;
    --text_inactive: var(--white2);

    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 10px;

    --highlight_color: var(--yellow2);
    --separator_hover: var(--purple3);
    --border_color: var(--grey5);

    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey6);
    --input_bg_focus: var(--grey8);

    --input_border: var(--grey4);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--purple3);

    --list_item_bg_selected: var(--purple5);
    --list_item_bg_hover: var(--grey4);

    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--purple6);
    --button_bg_disabled: var(--grey6);

    --button_border: var(--grey4);
    --button_border_hover: var(--purple3);
    --button_border_focus: var(--purple2);

    --tab_bg: var(--grey6);
    --tab_bg_hover: var(--grey5);
    --tab_bg_down: var(--grey4);
    --tab_bg_disabled: var(--grey6);

    --tab_border: var(--grey5);
    --tab_border_hover: var(--grey2);
    --tab_border_focus: var(--purple2);
    --tab_border_selected: var(--yellow2);

    --scrollbar_size: 10px;
    --scrollbar_bg: var(--grey6);
    --scrollbar_handle: var(--grey3);
    --scrollbar_hover: var(--purple4);
    --scrollbar_down: var(--purple3);
    --scrollbar_border: var(--purple4);

    --palette_light: var(--grey3);
    --palette_mid: var(--grey7);
    --palette_dark: var(--grey8);
    --palette_link: var(--purple1);
    --palette_linkVisited: var(--purple2);
}

QMainWindow::separator:hover {
    background: #6E44CF;
    border: none;
    margin: 1px;
    border-radius: 2px;
}

QToolTip {
    background-color: #171228;
    color: var(--white1);
    border: 1px solid var(--purple4);
    border-radius: var(--border_radius_small);
    padding: 4px 8px;
}

QMenuBar {
    background-color: var(--grey8);
    border-bottom: 1px solid var(--grey5);
}

QMenuBar::item {
    border-radius: var(--border_radius_small);
    margin: 2px 1px;
}

QMenuBar::item:selected {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8A5CF0, stop: 1 #52309E);
    color: var(--white1);
}

QMenuBar::item:pressed {
    background: var(--purple6);
}

QMenu {
    background-color: var(--grey7);
    border: 1px solid var(--grey4);
    border-radius: var(--border_radius);
    padding: 4px;
}

QMenu::item {
    border-radius: var(--border_radius_small);
    border: 1px solid transparent;
}

QMenu::item:selected,
QMenu::item:selected:hover,
QMenu::item:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #6E44CF, stop: 1 #4A2B8F);
    border: 1px solid #8A5CF0;
    color: var(--white1);
}

QMenu::separator {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 transparent, stop: 0.5 #6E5428, stop: 1 transparent);
    height: 1px;
}


QDockWidget {
    color: var(--white2);
    font-weight: bold;
}

QDockWidget::title {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #3A2763, stop: 0.55 #261C40, stop: 1 #201935);
    border: 1px solid var(--grey5);
    border-bottom: 1px solid #6E44CF;
    border-left: 3px solid #E4C27A;
    padding: var(--padding_large) var(--padding_xlarge);
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: var(--purple5);
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background: var(--purple6);
}

OBSDock > QWidget {
    background: var(--grey6);
    border: 1px solid var(--grey5);
    border-top: none;
}

OBSDock QToolBar {
    border-top: 1px solid var(--grey5);
    background: var(--grey7);
}

OBSDock QToolBar QToolButton {
    border-radius: var(--border_radius_small);
}

OBSDock QToolBar QToolButton:hover {
    background: var(--grey4);
    border-color: var(--purple4);
}

OBSDock QToolBar QToolButton:pressed {
    background: var(--purple6);
    border-color: var(--purple3);
}

OBSDock QToolBar QToolButton:disabled {
    background: transparent;
}


QListView::item,
QListWidget::item,
SourceTreeItem {
    border-radius: var(--border_radius_small);
}

QListView::item:hover,
QListWidget::item:hover {
    background: var(--grey5);
    border: 1px solid var(--grey4);
}

QListView::item:selected,
QListWidget::item:selected {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #6E44CF, stop: 0.6 #4E2E99, stop: 1 #3A2470);
    border: 1px solid #6E44CF;
    border-left: 3px solid #E4C27A;
    color: var(--white1);
}

QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8A5CF0, stop: 0.6 #5E38B5, stop: 1 #43297F);
    border: 1px solid #A57CFF;
    border-left: 3px solid #F3DCA4;
}

QListView::item:focus,
QListWidget::item:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border-color: #A57CFF;
}

QListView::item:disabled,
QListView::item:disabled:hover,
QListWidget::item:disabled,
QListWidget::item:disabled:hover {
    background: transparent;
    border-color: transparent;
}

QListView QLineEdit,
QListWidget QLineEdit {
    background: var(--grey8);
    border: 1px solid var(--purple3);
}

.list-grid SceneTree::item {
    background-color: var(--grey5);
    border: 1px solid var(--grey4);
}

.list-grid SceneTree::item:hover {
    background-color: var(--grey4);
    border-color: var(--purple4);
}

.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:checked {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8A5CF0, stop: 1 #52309E);
    border: 1px solid #E4C27A;
}

.list-grid SceneTree::item:selected:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #A57CFF, stop: 1 #6E44CF);
}


QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #30264C, stop: 1 #261D3E);
    border: 1px solid var(--grey4);
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #43356A, stop: 1 #32274F);
    border-color: var(--purple3);
}

QPushButton:focus {
    border-color: var(--purple2);
}

QPushButton:pressed,
QPushButton:pressed:hover {
    background-color: var(--purple6);
    border-color: var(--purple4);
}

QPushButton:checked {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8A5CF0, stop: 1 #5A36AE);
    border-color: #A57CFF;
}

QPushButton:checked:hover,
QPushButton:checked:focus {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #A57CFF, stop: 1 #6E44CF);
    border-color: #E4C27A;
}

QPushButton:disabled {
    background-color: var(--grey6);
    border-color: var(--grey5);
    color: var(--text_disabled);
}

QPushButton:default,
.button-primary {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #7A4FE0, stop: 1 #52309E);
    border: 1px solid #8A5CF0;
}

QPushButton:default:hover,
.button-primary:hover,
.button-primary:focus {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #9466F5, stop: 1 #6E44CF);
    border-color: #E4C27A;
}

QToolButton,
.btn-tool {
    background-color: var(--grey5);
    border-color: var(--grey4);
}

QToolButton:hover,
QToolButton:focus,
.btn-tool:hover,
.btn-tool:focus {
    background-color: var(--grey4);
    border-color: var(--purple3);
}

QToolButton:checked,
.btn-tool:checked {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8A5CF0, stop: 1 #5A36AE);
    border-color: #A57CFF;
}

QToolButton:pressed,
QToolButton:pressed:hover,
.btn-tool:pressed,
.btn-tool:pressed:hover {
    background-color: var(--purple6);
    border-color: var(--purple4);
}

.toolbar-button:hover {
    background: var(--grey5);
    border-color: var(--purple4);
}

QToolBarExtension {
    background: var(--grey5);
    border-radius: var(--border_radius_small);
}

.btn-create-new {
    border: 2px dashed var(--purple5);
}

.btn-create-new:hover {
    border-color: var(--yellow3);
    background: var(--grey6);
}


#controlsFrame QPushButton {
    font-weight: bold;
}

#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #6E44CF, stop: 1 #A3243E);
    border: 1px solid #E4C27A;
    color: var(--white1);
}

#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#replayBufferButton:!pressed.state-active,
#virtualCamButton:!pressed.state-active,
#modeSwitch:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8A5CF0, stop: 1 #C9304E);
    border: 1px solid #F3DCA4;
    color: var(--white1);
}


QComboBox,
QDateTimeEdit,
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: var(--grey5);
    border: 1px solid var(--grey4);
    selection-background-color: var(--purple4);
}

QComboBox:hover,
QDateTimeEdit:hover,
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: var(--grey1);
}

QComboBox:focus,
QComboBox:on,
QDateTimeEdit:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: var(--grey8);
    border-color: var(--purple3);
}

QLineEdit:read-only,
QLineEdit:read-only:hover,
QLineEdit:read-only:focus {
    background-color: transparent;
    border-color: var(--grey5);
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border-left: 1px solid var(--grey4);
}

QComboBox QAbstractItemView {
    background-color: var(--grey7);
    border: 1px solid var(--purple4);
    selection-background-color: var(--purple5);
}

QComboBox QAbstractItemView::item {
    border-radius: var(--border_radius_small);
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #6E44CF, stop: 1 #43297F);
    color: var(--white1);
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border-left: 1px solid var(--grey4);
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    border-top: 1px solid var(--grey4);
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: var(--purple5);
}


QTabWidget::pane {
    border-top: 2px solid var(--grey5);
}

QTabBar::tab {
    background: var(--grey6);
    border: 1px solid var(--grey5);
    color: var(--white4);
}

QTabBar::tab:hover {
    background: var(--grey5);
    border-color: var(--grey3);
    color: var(--white1);
}

QTabBar::tab:selected {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #3E2A6B, stop: 1 #2A2143);
    border-color: var(--purple5);
    color: var(--white1);
}

QTabBar::tab:top:selected {
    border-bottom: 2px solid #E4C27A;
}

QTabBar::tab:bottom:selected {
    border-top: 2px solid #E4C27A;
}


QGroupBox {
    background: var(--grey6);
    border: 1px solid var(--grey5);
    border-radius: var(--border_radius_large);
}

QGroupBox::title {
    color: var(--yellow2);
}

OBSBasicSettings #PropertiesContainer {
    background-color: var(--grey6);
}

.subtitle {
    color: var(--yellow3);
}

.text-bright {
    color: var(--purple1);
}

.frame-notice {
    background: var(--grey8);
    border: 1px solid var(--purple5);
    border-left: 3px solid var(--yellow2);
}

.dialog-frame {
    background-color: var(--grey6);
    border: 1px solid var(--grey5);
}


QScrollBar {
    background-color: transparent;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle {
    background-color: var(--grey3);
    border: 1px solid var(--grey3);
    border-radius: 3px;
}

QScrollBar::handle:hover {
    background-color: var(--purple4);
    border-color: var(--purple3);
}

QScrollBar::handle:pressed {
    background-color: var(--purple3);
    border-color: var(--purple2);
}

OBSDock QScrollBar:vertical {
    border-left: none;
}

OBSDock QScrollBar:horizontal {
    border-top: none;
}

::corner {
    background-color: transparent;
}


QSlider::groove {
    background-color: var(--grey8);
    border: 1px solid var(--grey4);
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
}

QSlider::groove:vertical {
    width: 4px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #52309E, stop: 1 #A57CFF);
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1: 0, y1: 1, x2: 0, y2: 0, stop: 0 #52309E, stop: 1 #A57CFF);
    border-radius: 3px;
}

QSlider::handle {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.6, fx: 0.4, fy: 0.35, stop: 0 #FFFFFF, stop: 0.6 #E3DCF7, stop: 1 #C9AEFF);
    border: 2px solid #C9A257;
    border-radius: 7px;
}

QSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -5px 0;
}

QSlider::handle:vertical {
    width: 10px;
    height: 10px;
    margin: 0 -5px;
}

QSlider::handle:hover {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.6, fx: 0.4, fy: 0.35, stop: 0 #FFFFFF, stop: 1 #E3DCF7);
    border-color: #F3DCA4;
}

QSlider::handle:pressed {
    background: #C9AEFF;
    border-color: #E4C27A;
}

QSlider::handle:disabled {
    background: var(--grey2);
    border-color: var(--grey3);
}

.slider-tbar::groove:horizontal {
    background: var(--grey8);
    border: 1px solid var(--grey4);
    border-radius: 4px;
}

.slider-tbar::sub-page:horizontal {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #52309E, stop: 0.7 #8A5CF0, stop: 1 #E4C27A);
    border-radius: 4px;
}

.slider-tbar::handle:horizontal {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #F3DCA4, stop: 1 #C9A257);
    border: 1px solid #F3DCA4;
    border-radius: 3px;
}


VolumeControl,
VolumeMeter {
    background: var(--grey6);
}

VolumeMeter {
    color: var(--grey3);

    qproperty-backgroundNominalColor: #2C1B55;
    qproperty-backgroundWarningColor: #4A3818;
    qproperty-backgroundErrorColor: #4A1424;
    qproperty-foregroundNominalColor: #A57CFF;
    qproperty-foregroundWarningColor: #E4C27A;
    qproperty-foregroundErrorColor: #F0506E;
    qproperty-magnitudeColor: #0E0A19;
    qproperty-majorTickColor: #B3A6D6;
    qproperty-minorTickColor: #5A4B7F;

    qproperty-backgroundNominalColorDisabled: #2A2735;
    qproperty-backgroundWarningColorDisabled: #34303F;
    qproperty-backgroundErrorColorDisabled: #3E3949;
    qproperty-foregroundNominalColorDisabled: #8C86A0;
    qproperty-foregroundWarningColorDisabled: #A39DB5;
    qproperty-foregroundErrorColorDisabled: #B9B3C9;
}

VolumeName:hover {
    background: var(--grey5);
    border-color: var(--purple4);
}

VolumeControl #volLabel {
    color: var(--white4);
}

.mixer-category {
    color: var(--yellow3);
}

.btn-mute:hover,
.btn-monitor:hover {
    background-color: var(--grey4);
}

.btn-mute.checked {
    color: var(--red2);
}

.btn-mute.checked.hover {
    background: var(--red6);
    border-color: var(--red2);
}

.btn-monitor.checked {
    background: var(--purple5);
}

.btn-monitor.checked:hover {
    background: var(--purple4);
    border-color: var(--purple1);
}

.toggle-hidden:checked {
    background: var(--purple5);
    border-color: var(--purple3);
}


QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked,
QTableView::indicator:unchecked {
    image: url(theme:NekoRaiden/checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked:hover,
QTableView::indicator:unchecked:hover {
    image: url(theme:NekoRaiden/checkbox_unchecked_focus.svg);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QTableView::indicator:checked {
    image: url(theme:NekoRaiden/checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover,
QGroupBox::indicator:checked:hover,
QTableView::indicator:checked:hover {
    image: url(theme:NekoRaiden/checkbox_checked_focus.svg);
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled,
QTableView::indicator:checked:disabled {
    image: url(theme:NekoRaiden/checkbox_checked_disabled.svg);
}

QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled,
QTableView::indicator:unchecked:disabled {
    image: url(theme:NekoRaiden/checkbox_unchecked_disabled.svg);
}

idian--CheckBox.keyFocus::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator {
    image: url(theme:NekoRaiden/checkbox_unchecked_focus.svg);
}

idian--CheckBox.keyFocus.checked::indicator,
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    image: url(theme:NekoRaiden/checkbox_checked_focus.svg);
}

.checkbox-icon:hover,
.checkbox-icon:focus {
    border-color: var(--purple3);
}

idian--ToggleSwitch {
    qproperty-background: #0E0A19;
    qproperty-background_hover: #171228;
    qproperty-background_checked: #6E44CF;
    qproperty-background_checked_hover: #8A5CF0;
    qproperty-handleColor: #F4F0FF;
    border: var(--highlight_width) solid var(--grey4);
}

idian--ToggleSwitch.hover {
    border-color: var(--grey2);
}

idian--ToggleSwitch.checked.hover {
    border-color: #E4C27A;
}

idian--Row {
    background: var(--grey5);
}

idian--Row.keyFocus,
idian--Row.cursor-pointer.hover {
    background: var(--grey4);
    border-color: var(--purple4);
}

idian--RowFrame .btn-frame {
    background: var(--grey5);
}

idian--RowFrame.hover .btn-frame,
idian--RowFrame.hover idian--Row,
idian--RowFrame.hover .row-buddy {
    background: var(--grey4);
    border-color: var(--purple4);
}

idian--ExpandButton::indicator {
    background: var(--grey4);
    border-color: var(--grey4);
}

AlignmentSelector::indicator:checked {
    background: var(--purple4);
}

AlignmentSelector::indicator:checked:focus {
    background: var(--purple3);
}


QProgressBar {
    background: var(--grey8);
    border: 1px solid var(--grey5);
    border-radius: 5px;
    color: var(--white1);
}

QProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #52309E, stop: 0.75 #8A5CF0, stop: 1 #E4C27A);
    border: none;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: var(--grey5);
    border: none;
    border-right: 1px solid var(--grey4);
    border-bottom: 1px solid var(--purple5);
    color: var(--white3);
    padding: 4px 6px;
}

QTableView {
    gridline-color: var(--grey5);
    selection-background-color: var(--purple5);
}

OBSBasicStatusBar {
    background: var(--grey8);
    border-top: 1px solid var(--grey5);
}

StatusBarWidget > QFrame {
    border-color: var(--grey5);
}

#contextContainer {
    background-color: var(--grey6);
    border: 1px solid var(--grey5);
}

SourceSelectButton {
    background: var(--grey5);
    border: 1px solid var(--grey4);
}

SourceSelectButton:hover {
    background-color: var(--grey4);
    border-color: var(--purple3);
}

SourceSelectButton:checked {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #6E44CF, stop: 1 #43297F);
    border-color: #E4C27A;
}

SourceSelectButton #thumbnail {
    background: var(--grey7);
}

#ytEventList .row-selected {
    background: var(--purple5);
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: var(--grey5);
}

QCalendarWidget QAbstractItemView:enabled {
    selection-background-color: var(--purple4);
}


SceneTree {
    background-image: url(theme:NekoRaiden/art/neko-raiden.png);
    background-position: bottom center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

SourceTree {
    background-image: none;
    background-position: bottom right;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

#hMixerScrollArea,
#vMixerScrollArea {
    background-image: url(theme:NekoRaiden/art/sit.svg);
    background-position: bottom right;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

OBSBasicSettings #listWidget {
    background-image: url(theme:NekoRaiden/art/loaf.svg);
    background-position: bottom center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}
